# =====================================================
# Firebase Web SDK
# Firebase Console > Configuracion del proyecto > Tus apps > SDK config
# =====================================================
NG_APP_FIREBASE_API_KEY=
NG_APP_FIREBASE_AUTH_DOMAIN=
NG_APP_FIREBASE_PROJECT_ID=
NG_APP_FIREBASE_STORAGE_BUCKET=
NG_APP_FIREBASE_MESSAGING_SENDER_ID=
NG_APP_FIREBASE_APP_ID=

# =====================================================
# Identificador del album activo en Firestore.
# Si lo dejas vacio se usa "wc2026" (default).
# Cambialo solo si tu catalogo usa otro id.
# =====================================================
NG_APP_ALBUM_ID=

# =====================================================
# Whitelist de cuentas autorizadas a entrar (separadas por coma).
# - Vacio  = modo abierto, cualquier cuenta de Google autenticada entra.
# - Con valores = solo esos correos pueden ingresar.
#
# Tambien tienes que reflejar la misma lista en firestore.rules
# (funcion isAllowlisted), o las reglas bloquearan los reads/writes.
#
# Ejemplo: NG_APP_ALLOWED_EMAILS=tu@gmail.com,amigo1@gmail.com
# =====================================================
NG_APP_ALLOWED_EMAILS=
