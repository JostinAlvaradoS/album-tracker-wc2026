rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Whitelist de acceso ---
    // Solo cuentas de Google con email verificado e incluido en la lista
    // pueden leer/escribir cualquier dato. Mantener esta lista sincronizada
    // con ALLOWED_EMAILS en angular/src/app/core/services/auth.service.ts
    function isAllowlisted() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'jostinalvaradosarmiento@gmail.com'
        ];
    }

    // --- Catálogo del álbum: lectura solo para autorizados.
    //     Escritura siempre bloqueada en cliente (se importa con Admin SDK).
    match /albums/{albumId} {
      allow read: if isAllowlisted();
      allow write: if false;

      match /sections/{sectionId} {
        allow read: if isAllowlisted();
        allow write: if false;
      }

      match /stickers/{stickerId} {
        allow read: if isAllowlisted();
        allow write: if false;
      }
    }

    // --- Inventario del usuario: solo el dueño autorizado.
    match /users/{uid}/collections/{albumId} {
      allow read, write: if isAllowlisted() && request.auth.uid == uid;

      match /items/{stickerId} {
        allow read, write: if isAllowlisted() && request.auth.uid == uid;
      }
    }
  }
}
