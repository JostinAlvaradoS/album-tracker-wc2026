rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Catálogo del álbum: lectura para usuarios autenticados,
    //     escritura solo desde el Admin SDK (scripts), nunca desde el cliente.
    match /albums/{albumId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /sections/{sectionId} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      match /stickers/{stickerId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // --- Inventario de cada usuario: solo el dueño accede.
    match /users/{uid}/collections/{albumId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;

      match /items/{stickerId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }
    }
  }
}
